          "cosine": 0.7081831693649292
        }
      ]
    },
    {
      "sent_id": "fin6_MagecartCardSkimmersInjectedIntoOnlineShops_sent_24",
      "text": "It's also interesting to see that the skimmer in this attack binds to event 'mousedown' and event 'touchstart' of the payment submit button.",
      "hits": [
        {
          "clean_id": "S0556",
          "name": "Pay2Key",
          "cosine": 0.7655017971992493
        },
        {
          "clean_id": "S0478",
