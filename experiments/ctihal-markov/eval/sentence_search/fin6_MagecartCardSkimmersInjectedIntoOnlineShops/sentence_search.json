          "cosine": 0.7846509218215942
        },
        {
          "clean_id": "T1070",
          "name": "Indicator Removal",
          "cosine": 0.7845473885536194
        },
        {
          "clean_id": "T1553",
          "name": "Subvert Trust Controls",
          "cosine": 0.7834056615829468
        },
        {
          "clean_id": "T1027",
          "name": "Obfuscated Files or Information",
          "cosine": 0.7824215888977051
        }
      ]
    },
    {
      "sent_id": "fin6_MagecartCardSkimmersInjectedIntoOnlineShops_sent_26",
      "text": "It seems that Magecart is continuing to change and experiment with new attack methods, refining its skimmer to evade detection.",
      "hits": [
        {
          "clean_id": "S0579",
          "name": "Waterbear",
          "cosine": 0.7589808702468872
        },
        {
          "clean_id": "S1092",
