          "cosine": 0.7516584396362305
        }
      ]
    },
    {
      "sent_id": "fin6_MagecartCardSkimmersInjectedIntoOnlineShops_sent_25",
      "text": "The previous Group 6 skimmer binds to event 'mouseup' and event 'touchend'.",
      "hits": [
        {
          "clean_id": "S1042",
          "name": "SUGARDUMP",
          "cosine": 0.7146706581115723
        },
        {
          "clean_id": "S0608",
